// Muhasebe / ön muhasebe uygulaması — çekirdek şema
// Kaynak: ROADMAP.md "Veritabanı Şeması". Geliştirme fazında SQLite kullanılır;
// PostgreSQL'e geçiş ROADMAP.md Faz 9'da ele alınacak.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  PERSONEL
}

enum CariTipi {
  MUSTERI
  TEDARIKCI
  HER_IKISI
}

enum IslemTipi {
  SATIS
  ALIS
}

enum OdemeStatusu {
  ODENDI
  KISMI_ODENDI
  BEKLIYOR
  IPTAL
}

/// Fatura ödemesinin nereden geldiği. Bakiye etkisi buna BAĞLIDIR:
/// DIREKT ödeme cari bakiyesini düşürür; CEK_TAHSILATI ise düşürmez, çünkü
/// o para çek tahsilatı kaydedilirken bakiyeden zaten düşülmüştür.
/// Bu ayrım olmadan çekle ödenen fatura bakiyeyi İKİ KEZ azaltırdı.
enum ProformaDurumu {
  TASLAK
  GONDERILDI
  KABUL
  RED
  ISLEME_DONUSTU
}

enum OdemeKaynagi {
  DIREKT
  /// Faturayi kapatan sey CEKIN KENDISIDIR, tahsilati degil: cek ele
  /// gectiginde cari hesap kapanir, tahsilat sonradan gelen bir kasa
  /// olayidir. Onceki CEK_TAHSILATI degeri bu yuzden kaldirildi.
  CEK
}

enum CekSenetTipi {
  CEK
  SENET
}

enum CekSenetYonu {
  ALINAN // müşteriden alındı — tahsil edeceğiz (varlık)
  VERILEN // tedarikçiye verildi — ödeyeceğiz (yükümlülük)
}

enum CekSenetDurumu {
  PORTFOYDE
  CIRO_EDILDI
  TAHSIL_EDILDI
  KARSILIKSIZ
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  // Auth.js Credentials provider için gerekli; ROADMAP şemasına eklenen tek alan.
  passwordHash String
  role         Role       @default(PERSONEL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Cari {
  id           String     @id @default(cuid())
  unvan        String
  vknTckn      String?
  vergiDairesi String?
  tip          CariTipi
  telefon      String?
  email        String?
  adres        String?
  // Türkçe arama anahtarı: tr-locale küçük harf + şapka/nokta katlaması.
  // SQLite LIKE yalnızca ASCII'de büyük/küçük ayrımı yapmadığı için gerekli.
  aramaAnahtari String    @default("")
  // Cari kartı açılırken devreden bakiye. Yürüyen bakiyenin çıkış noktasıdır.
  acilisBakiyesi Decimal  @default(0)
  // Yürüyen bakiye — pozitif: alacak, negatif: borç.
  // HER ZAMAN acilisBakiyesi + Σ(işlem etkisi) değerine eşittir; elle
  // düzenlenmez, cariBakiyesiniDogrula() ile mutabakatı ölçülür.
  bakiye       Decimal    @default(0)
  // İşlem/çek kaydı olan cari silinemez (onDelete: Restrict); bunun yerine
  // pasife alınır. Muhasebe kaydı sessizce yok edilmemeli.
  aktif        Boolean    @default(true)
  islemler     Islem[]
  proformalar  Proforma[]
  cekSenetler  CekSenet[] @relation("CekSenetCari")
  // Bize verilmiş bir çekin ciro edildiği cari (tedarikçi) tarafı.
  ciroEdilenCekler CekSenet[] @relation("CiroEdilenCari")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([unvan])
  @@index([tip])
  @@index([aktif])
  @@index([aramaAnahtari])
}

model Islem {
  id          String        @id @default(cuid())
  tip         IslemTipi
  cariId      String
  // Restrict: işlemi olan cari silinemez — muhasebe kaydı sessizce yok edilmemeli.
  cari        Cari          @relation(fields: [cariId], references: [id], onDelete: Restrict)
  kalemler    IslemKalemi[]
  toplamTutar Decimal
  kdvTutari   Decimal
  status      OdemeStatusu  @default(BEKLIYOR)
  odenenTutar Decimal       @default(0)
  // Belge tarihi. createdAt kayıt anıdır; geriye dönük fatura girmek yaygın
  // olduğu için sıralama ve raporlama bu alana göre yapılır.
  tarih       DateTime      @default(now())
  vadeTarihi  DateTime?
  odemeler    IslemOdeme[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([cariId])
  @@index([status])
  @@index([tarih])
  @@index([vadeTarihi])
}

/// Fatura bazında ödeme/tahsilat kaydı.
///
/// `Islem.odenenTutar` HER ZAMAN Σ IslemOdeme.tutar değerine eşittir ve
/// `status` bundan türetilir. Bu kayıt olmadan bir faturanın ödenip ödenmediği
/// bilinemez (cari bakiyesi yalnızca toplamı verir, fatura bazında dağılımı değil)
/// — yaşlandırma raporu bunu gerektirir.
model IslemOdeme {
  id      String       @id @default(cuid())
  islemId String
  islem   Islem        @relation(fields: [islemId], references: [id], onDelete: Cascade)
  tutar   Decimal
  tarih   DateTime     @default(now())
  kaynak  OdemeKaynagi @default(DIREKT)
  /// Bu odemeyle kasaya/bankaya giren (veya cikan) para hareketi. Odeme
  /// silinince ayni transaction'da bu da silinir; aksi halde odeme kaydi
  /// kalkarken para kasada asili kalirdi.
  hesapHareketiId String?        @unique
  hesapHareketi   HesapHareketi? @relation(fields: [hesapHareketiId], references: [id], onDelete: SetNull)
  /// Kaynak CEK ise hangi cek/senet bu faturayi kapatiyor. Bir cekin
  /// faturalara dagitilan toplami, cek tutarini asamaz.
  cekSenetId String?
  cekSenet   CekSenet? @relation(fields: [cekSenetId], references: [id], onDelete: Restrict)
  aciklama  String?
  createdAt DateTime @default(now())

  @@index([islemId])
  @@index([cekSenetId])
  @@index([tarih])
}

model IslemKalemi {
  id         String  @id @default(cuid())
  islemId    String
  islem      Islem   @relation(fields: [islemId], references: [id], onDelete: Cascade)
  urunAdi    String
  miktar     Decimal
  birimFiyat Decimal
  kdvOrani   Decimal

  @@index([islemId])
}

model KasaBanka {
  id         String          @id @default(cuid())
  ad         String
  tip        String // "KASA" | "BANKA"
  // Yürüyen bakiye. HesapHareketi toplamıyla HER ZAMAN eşit kalmalıdır;
  // yazma işlemleri transaction içinde bu alanı da günceller ve
  // hesapBakiyesiniDogrula() ile mutabakatı test edilir.
  bakiye     Decimal         @default(0)
  // Hareketi olan hesap silinemez (onDelete: Restrict); pasife alınır — Cari ile aynı kural.
  aktif      Boolean         @default(true)
  hareketler HesapHareketi[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tip])
  @@index([aktif])
}

model HesapHareketi {
  id       String    @id @default(cuid())
  hesapId  String
  hesap    KasaBanka @relation(fields: [hesapId], references: [id], onDelete: Restrict)
  tutar    Decimal // + giriş, - çıkış
  aciklama String?
  tarih    DateTime  @default(now())

  /// Bu hareketi URETEN kayit. Elle girilen harekette hepsi bostur.
  /// Kaynagi olan hareket kasa ekranindan tek basina silinemez — silinseydi
  /// tahsilat/odeme kaydi dururken parasi kasadan kaybolurdu.
  odeme    IslemOdeme?
  tahsilat CekSenetTahsilat?
  gider    Gider?

  @@index([hesapId])
  @@index([tarih])
}

model CekSenet {
  id     String       @id @default(cuid())
  tip    CekSenetTipi
  // Yön, tahsilatın cari bakiyesine hangi işaretle yansıyacağını belirler:
  // ALINAN tahsil edilince carinin bize borcu azalır, VERILEN ödenince
  // bizim borcumuz azalır. ROADMAP şemasına eklenen alan.
  yon    CekSenetYonu
  cariId String
  cari   Cari         @relation("CekSenetCari", fields: [cariId], references: [id], onDelete: Restrict)
  // Ciro: alınan çek bir tedarikçiye devredilir. Bu, İKİ cari bakiyesini birden
  // etkiler (çeki veren müşterinin borcu kapanır, tedarikçiye borcumuz azalır),
  // bu yüzden hedef cari kaydedilmek zorundadır — yoksa etki hesaplanamaz.
  ciroEdilenCariId String?
  ciroEdilenCari   Cari?    @relation("CiroEdilenCari", fields: [ciroEdilenCariId], references: [id], onDelete: Restrict)
  ciroTarihi       DateTime?
  tutar  Decimal
  // Tahsil edilen toplam. HER ZAMAN Σ CekSenetTahsilat.tutar değerine eşittir;
  // elle yazılmaz, cekSenetiDogrula() ile mutabakatı ölçülür.
  tahsilEdilen Decimal          @default(0)
  /// Çekin ALINDIĞI / VERİLDİĞİ tarih — vade değil. Cari bakiyesi bu anda
  /// değiştiği için ekstre bu tarihe göre sıralanır. createdAt kullanılsaydı
  /// geriye dönük girilen çek ekstrede giriş gününe düşerdi.
  tarih        DateTime         @default(now())
  vadeTarihi   DateTime
  durum        CekSenetDurumu   @default(PORTFOYDE)
  /// Karşılıksız işaretlendiği tarih. updatedAt kullanılsaydı çekin herhangi
  /// bir alanı düzenlendiğinde ekstredeki geri dönüş satırı yer değiştirirdi.
  karsiliksizTarihi DateTime?
  aciklama     String?
  tahsilatlar  CekSenetTahsilat[]
  /// Bu cekin kapattigi faturalar (kismen dagitilabilir).
  islemOdemeleri IslemOdeme[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([cariId])
  @@index([durum])
  @@index([tarih])
  @@index([vadeTarihi])
  @@index([yon])
  @@index([ciroEdilenCariId])
}

/// Kısmi tahsilatlar tek tek kaydedilir: "birden fazla kısmi tahsilat"
/// izlenebilir ve tek tek geri alınabilir olmalı (ROADMAP Faz 4 doğrulaması).
model CekSenetTahsilat {
  id         String   @id @default(cuid())
  cekSenetId String
  cekSenet   CekSenet @relation(fields: [cekSenetId], references: [id], onDelete: Cascade)
  tutar      Decimal
  tarih      DateTime @default(now())
  aciklama   String?
  /// Tahsil edilen paranin girdigi kasa/banka hareketi.
  hesapHareketiId String?        @unique
  hesapHareketi   HesapHareketi? @relation(fields: [hesapHareketiId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())

  @@index([cekSenetId])
  @@index([tarih])
}

model Gider {
  id       String  @id @default(cuid())
  kategori String
  /// KDV DAHİL toplam tutar — fişin üzerindeki rakam. Islem.toplamTutar ile
  /// aynı anlamda (brüt), böylece iki yerde farklı bir "tutar" kavramı olmaz.
  tutar    Decimal
  /// Yüzde olarak KDV oranı. Türkiye'de masraf fişleri KDV içerir ve bu tutar
  /// Faz 7'deki KDV raporunda "indirilecek KDV" tarafını besler.
  kdvOrani Decimal @default(0)
  /// tutar içinden ayrılan KDV. Saklanır çünkü oran zamanla değişebilir;
  /// geçmiş kayıt kendi dönemindeki KDV'sini korumalıdır.
  kdvTutari Decimal @default(0)
  aciklama  String?
  /// Yüklenen fiş/dekontun depodaki anahtarı (bkz. lib/storage.ts).
  belgeUrl  String?
  /// Kullanıcının yüklediği dosyanın özgün adı — indirirken gösterilir.
  belgeAdi  String?
  /// Giderin odendigi kasa/banka hareketi (cikis).
  hesapHareketiId String?        @unique
  hesapHareketi   HesapHareketi? @relation(fields: [hesapHareketiId], references: [id], onDelete: SetNull)
  tarih     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kategori])
  @@index([tarih])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  aksiyon   String // "DELETE", "UPDATE", "PARTIAL_PAYMENT" vb.
  hedefTip  String // "Islem", "CekSenet" vb.
  hedefId   String
  detay     Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([hedefTip, hedefId])
  @@index([createdAt])
}

/// Firma bilgileri — tek satırlık ayar kaydı.
/// Proforma başlığında (logo/kaşe alanı) ve paylaşım metinlerinde kullanılır.
model Firma {
  id           String  @id @default("firma")
  unvan        String  @default("")
  vknTckn      String?
  vergiDairesi String?
  adres        String?
  telefon      String?
  email        String?
  iban         String?
  /// Yüklenen logonun depo anahtarı (bkz. lib/storage.ts).
  logoUrl      String?
  logoAdi      String?
  updatedAt    DateTime @updatedAt
}

/// Proforma (teklif).
///
/// İşlemden AYRI bir modeldir ve hiçbir bakiyeyi etkilemez: proforma satış
/// öncesi bir tekliftir, gerçekleşmemiş bir satışı İşlem olarak kaydetmek
/// müşterinin borcunu haksız yere artırırdı. Teklif kabul edilince
/// `isleme dönüştür` ile gerçek İşlem oluşturulur.
model Proforma {
  id            String          @id @default(cuid())
  /// Kullanıcıya gösterilen sıra numarası (PRF-2026-0001).
  no            String          @unique
  cariId        String
  cari          Cari            @relation(fields: [cariId], references: [id], onDelete: Restrict)
  tarih         DateTime        @default(now())
  gecerlilikTarihi DateTime?
  durum         ProformaDurumu  @default(TASLAK)
  notlar        String?
  toplamTutar   Decimal         @default(0)
  kdvTutari     Decimal         @default(0)
  kalemler      ProformaKalemi[]
  /// Kabul edilip İşleme dönüştürüldüyse oluşan işlem.
  islemId       String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([cariId])
  @@index([durum])
  @@index([tarih])
}

model ProformaKalemi {
  id         String   @id @default(cuid())
  proformaId String
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  urunAdi    String
  miktar     Decimal
  /// KDV hariç net birim fiyat — İslemKalemi ile aynı anlamda.
  birimFiyat Decimal
  kdvOrani   Decimal

  @@index([proformaId])
}
